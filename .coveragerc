# Test coverage of the student app's Python code (job "Code quality").
# Run locally from the repository root:
#   python -m pytest logger/search-app/tests --ignore-glob='*browser.py' --cov --cov-report=term
[run]
source = logger/search-app
omit =
    logger/search-app/tests/*
# Relative paths let SonarQube Cloud match the report to the analysed files.
relative_files = True

[report]
skip_empty = True
# A file's `if __name__ == "__main__":` block runs only when it is started by hand
# (`python search_app.py`); tests import the module, so they can never reach it.
exclude_also =
    if __name__ == .__main__.:
